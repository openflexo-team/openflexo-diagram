/**
 * Testing FML-controlled diagram
 */

use org.openflexo.foundation.fml.rt.AbstractFMLRTModelSlot as FMLRT;
use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;

import DiagramSpecification DIAGRAM_SPECIFICATION from ["http://some_uri/ADiagSpecification.diagramspecification"];
import Diagram EXAMPLE_DIAGRAM from [DIAGRAM_SPECIFICATION+"/ExampleDiagram.diagram"];
import DiagramShape RED_SHAPE from [EXAMPLE_DIAGRAM:"SYL_56"];
import DiagramConnector BLUE_ARC from [EXAMPLE_DIAGRAM:"SYL_78"];
import DiagramShape RED_SHAPE2 from [EXAMPLE_DIAGRAM:"SYL_56"];

model MyModel {
	
	Diagram diagram with DIAGRAM::TypedDiagramModelSlot(
		diagramSpecification = DIAGRAM_SPECIFICATION,
		paletteElementBindings = {
			FMLDiagramPaletteElementBinding:(paletteElementId="MyPaletteElement",call=new MyConceptGR::dropNewConcept("foo")),
			FMLDiagramPaletteElementBinding:(paletteElementId="MyPaletteElement2",call=new MyConceptGR::dropNewConcept2("foo2"))
		});

	ConceptualModel conceptualModel;
	
	concept MyConceptGR {
		
		MyConcept myConcept;
		DiagramShape shape with DIAGRAM::ShapeRole (
			metamodelElement = RED_SHAPE,
			label = myConcept.name
		);
		
		// DropScheme
		dropNewConcept(String name) with DIAGRAM::DropScheme(target="topLevel") {
			myConcept = new MyConcept::init(name);
			shape = DIAGRAM::AddShape(container="topLevel") in (diagram);
		}
		
		dropNewConcept2(String name) with DropScheme(target="topLevel") {
			myConcept = new MyConcept::init(name);
			shape = DIAGRAM::AddShape(container="topLevel") in (diagram);
		}

		delete::deleteConcept() {
			delete(myConcept);
			delete(shape);
		}
		
		delete::removeFromDiagram() {
			myConcept = null;
			delete(shape);
		}
	}
	
	concept LinkGR {
		
		MyConceptGR fromGR;
		MyConceptGR toGR;
		DiagramConnector connector with DIAGRAM::ConnectorRole (
			metamodelElement = BLUE_ARC,
			label = "connected with"
		);
		
		// LinkScheme
		linkConcepts() with LinkScheme(fromTarget="MyConceptGR",toTarget="MyConceptGR") {
			fromGR = fromTarget;
			toGR = toTarget;
			performLink(fromTarget.myConcept,toTarget.myConcept);
			connector = DIAGRAM::AddConnector(fromShape=fromGR.shape,toShape=toGR.shape) in (diagram);
		}
		
		performLink(MyConcept fromConcept, MyConcept toConcept) {
			fromConcept.connectedWith = toConcept;			
		}
		
	}


}
